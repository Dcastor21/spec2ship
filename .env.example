# Copy to .env and fill in. .env is gitignored; never commit real keys.

# Models (LiteLLM model strings). The reviewer must differ from the implementer.
S2S_PLANNER_MODEL=anthropic/claude-haiku-5-5
S2S_IMPLEMENTER_MODEL=anthropic/claude-haiku-5-5
S2S_REVIEWER_MODEL=anthropic/claude-sonnet-5-5

# Provider keys
ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=

# Optional tracing (T2.8). Leave unset to write only runs/<run-id>/trace.jsonl.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=
