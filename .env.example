# Copy to .env and fill in. .env is gitignored; never commit real keys.

# Provider API key(s): the exact variable depends on the LLM wrapper chosen in T2.1.
# OPENROUTER_API_KEY=

# Models per role. The reviewer must be a different model from the implementer.
S2S_PLANNER_MODEL=
S2S_IMPLEMENTER_MODEL=
S2S_REVIEWER_MODEL=

# Optional tracing (T2.8). Leave unset to write local JSONL traces only.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=
